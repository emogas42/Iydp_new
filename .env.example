# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

# A long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# SQLite is the default (fine for cPanel shared hosting). To use MySQL/Postgres
# instead, set e.g.: mysql+pymysql://user:password@localhost/iydp
DATABASE_URL=sqlite:///iydp.db

# Leave as 1 (default) in production — cookies are only sent over HTTPS.
# Set to 0 only for local development over plain http://
SESSION_COOKIE_SECURE=1

# Never set this to 1 in production — it enables Flask's interactive
# debugger, which allows remote code execution if reachable. Leave unset
# or 0 outside of local development.
FLASK_DEBUG=0
