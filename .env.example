# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

# A long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# The first admin account is created from these on first start. There is no
# default password: without ADMIN_PASSWORD no admin is created. Use a long one,
# and remove it from this file once you have signed in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SQLite is the default (fine for cPanel shared hosting). To use MySQL/Postgres
# instead, set e.g.: mysql+pymysql://user:password@localhost/iydp
DATABASE_URL=sqlite:///iydp.db

# Leave as 1 (default) in production — cookies are only sent over HTTPS.
# Set to 0 only for local development over plain http://
SESSION_COOKIE_SECURE=1

# How many proxies stand in front of the app. nginx only: 1. Cloudflare and nginx: 2.
# Too high lets visitors fake their IP; 0 behind a proxy makes all visitors share
# one rate limit.
TRUSTED_PROXY_HOPS=0

# Public address of the site, used for links in emails. Needed for email confirmation
# and for "forgot password".
SITE_URL=https://iydp.org

# Email for confirming addresses and for decision notices. Leave MAIL_SERVER empty to
# send none: members are then not asked to confirm, and see notices on their account page. Port 465 uses SSL, any other port STARTTLS.
# The real password belongs in .env only, never in this file.
# The name must match the server's certificate. On Hetzner webhosting: mail.your-server.de
# Check it with: python scripts/test_mail.py you@example.com
MAIL_SERVER=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=IYDP <noreply@iydp.org>
# Where replies go, so that people who answer a mail reach someone. Optional.
MAIL_REPLY_TO=
# Gets a mail for every message from the contact form. Empty: they only appear in the admin panel.
CONTACT_NOTIFY_EMAIL=

# Never set this to 1 in production — it enables Flask's interactive
# debugger, which allows remote code execution if reachable. Leave unset
# or 0 outside of local development.
FLASK_DEBUG=0
